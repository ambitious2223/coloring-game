{
  "name": "color-chaos",
  "version": "0.1.0",
  "private": true,
  "description": "Color Chaos - collaborative numbered coloring game for TikTok LIVE (Tikora hub game).",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "gen": "node scripts/generate-svg.mjs",
    "gen:photo": "node scripts/generate-svg.mjs --style photo",
    "gen:demo": "node scripts/gen-demo-canvas.mjs",
    "validate": "node scripts/validate-canvas.mjs src/js/data/canvases/canvas-demo",
    "validate:all": "node scripts/validate-canvas.mjs --all",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "npm run validate:all && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
